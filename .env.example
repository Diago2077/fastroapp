# ── Cliente (se empaquetan en el bundle, son publicas por diseno) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Servidor: SOLO para las funciones de /api ──
# Sin prefijo VITE_, si no quedarian expuestas en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificaciones push (clave PUBLICA VAPID; el par se genera una vez) ──
VITE_VAPID_PUBLIC_KEY=
